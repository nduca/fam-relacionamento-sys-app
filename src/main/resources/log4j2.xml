<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{ISO8601} %-5p [correlationId=%X{correlationId}] %c - %m%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="br.com.fam.api.request" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="br.com.fam.api.response" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="br.com.fam.api.error" level="ERROR" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.mule.service.http" level="WARN"/>
        <Logger name="org.mule.extension.http" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>
